{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "K8sFocus",
  "version": "1.0.2",
  "identifier": "online.tools247.k8sfocus",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "K8sFocus",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "theme": "Dark",
        "backgroundColor": "#141416"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Desktop Kubernetes client",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "homepage": "https://github.com/imashiksarkar/K8sFocus"
  },
  "mainBinaryName": "K8sFocus",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdFRDQ5QTNERTkzRkZBRUEKUldUcStqL3BQWnJVZnNGRXBZRkxrUGJRQnhjK3B0VjJTUzEydSttcG1uRXBYSk8rUUhQaXgwM1AK",
      "endpoints": [
        "https://github.com/imashiksarkar/K8sFocus/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
